{
  "name": "yems-ecommerce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Yem's — souliers et maroquinerie cousus main. Site statique généré + fonctions serveur.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "python3 tools/build.py || python tools/build.py",
    "images": "python3 tools/process_images.py || python tools/process_images.py",
    "db:schema": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "dev": "echo \"Le developpement local demande un Postgres local. Utilise plutot : npm run deploy\"",
    "test:pricing": "node tools/test-pricing.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "wrangler": "^4.122.0"
  }
}
