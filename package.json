{
  "name": "yems-ecommerce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Yem's — souliers et maroquinerie cousus main. Site statique généré + fonctions serveur.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "python3 tools/build.py",
    "images": "python3 tools/process_images.py",
    "db:schema": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "dev": "vercel dev",
    "test:pricing": "node tools/test-pricing.mjs"
  },
  "dependencies": {
    "@kkiapay-org/nodejs-sdk": "^0.2.0",
    "postgres": "^3.4.4"
  }
}
