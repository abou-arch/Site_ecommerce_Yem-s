# ===========================================================================
# Yem's — Variables d'environnement
#
# Copier en .env pour le développement local (vercel dev).
# En production : Vercel → Settings → Environment Variables.
#
# ⚠ Ce fichier est un modèle. Le vrai .env ne doit JAMAIS être commité —
#   il est déjà couvert par .gitignore.
# ===========================================================================

# ─── Base de données ───────────────────────────────────────────────────────
# Neon : https://neon.tech → Connection string (pooled)
# Supabase : Settings → Database → Connection pooling
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Mode de règlement ─────────────────────────────────────────────────────
# "offline" (défaut) : la commande est enregistrée, l'atelier est prévenu sur
#   WhatsApp, le client règle à la livraison ou par transfert Mobile Money.
#   C'est le mode à garder tant qu'aucun compte marchand n'est activé.
#
# "online" : ajoute le paiement par widget. Exige un compte marchand validé
#   ET les trois clés ci-dessous. Le serveur retombe automatiquement sur
#   "offline" si la clé publique manque — la boutique ne casse jamais.
PAYMENT_MODE=offline

# ─── KkiaPay ───────────────────────────────────────────────────────────────
# https://app.kkiapay.me/dashboard → Développeurs
#
# La clé PUBLIQUE est la seule qui descend dans le navigateur.
# La clé PRIVÉE et le SECRET ne quittent jamais le serveur : la privée sert à
# vérifier les transactions, le secret à authentifier les webhooks.
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=

# true tant que le compte n'est pas activé — utilise les numéros de test KkiaPay
KKIAPAY_SANDBOX=true

# ─── WhatsApp ──────────────────────────────────────────────────────────────
# Numéro de l'atelier, format international sans le +
OWNER_WHATSAPP=22900000000

# Facultatif : API WhatsApp Cloud (Meta). Sans ces deux valeurs, l'admin
# affiche un lien wa.me à cliquer — la boutique fonctionne quand même.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ─── Administration ────────────────────────────────────────────────────────
# Secret partagé pour /api/admin/*. 32 caractères minimum.
# Générer :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
